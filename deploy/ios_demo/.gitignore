# CocoaPods
PaddleOCRDemo/Pods/
PaddleOCRDemo/Podfile.lock

# Xcode
PaddleOCRDemo/PaddleOCRDemo.xcworkspace/xcuserdata/
PaddleOCRDemo/PaddleOCRDemo.xcodeproj/xcuserdata/
PaddleOCRDemo/PaddleOCRDemo.xcodeproj/project.xcworkspace/xcuserdata/
*.xcuserstate
DerivedData/
build/

# fetch_ios_demo_assets.sh cache (downloaded model .tar)
.fetch_ios_demo_assets_work/
.download_models_work/

# Demo sample PNG — downloaded by fetch_ios_demo_assets.sh; not tracked in git.
PaddleOCRDemo/PaddleOCRDemo/Resources/SampleImages/*.png

# Models — ignore all files under Models/; track only `.gitkeep` so det/, rec/, … stay in the tree
PaddleOCRDemo/PaddleOCRDemo/Models/**
!PaddleOCRDemo/PaddleOCRDemo/Models/*/
!PaddleOCRDemo/PaddleOCRDemo/Models/*/.gitkeep
